# Copy to .env and edit — the collector runs fine with defaults (no keys needed for public data)

# Upstream Kalshi public API (leave as-is for prod; use demo for safe testing)
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2

# Poll intervals (ms)
SYNC_INTERVAL_MS=15000
SNAPSHOT_INTERVAL_MS=5000
BOOK_SNAPSHOT_INTERVAL_MS=15000
TRADE_POLL_INTERVAL_MS=60000
CANDLE_POLL_INTERVAL_MS=300000

# Rate limiting — Basic tier is ~20 req/s (200 tokens/s, 10 tokens per call);
# stay conservatively below it (matches collector/config.py default)
KALSHI_MAX_RPS=8
KALSHI_SYNC_TIMEOUT_MS=8000
KALSHI_BATCH_MARKETS_LIMIT=200
KALSHI_BATCH_ORDERBOOKS=100

# Local engine / DB
PORT=8080
HOST=0.0.0.0
DB_PATH=data/exchange.db
PARQUET_PATH=data/parquet
STARTING_BALANCE=10000
COLLECTOR_LOG_LEVEL=INFO

# Optional: authenticated historical endpoints (only needed if you want /historical/* via signed calls)
# Generate at https://kalshi.com/account/api
# KALSHI_ACCESS_KEY=
# KALSHI_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----...
# Or path to file:
# KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private.pem

# Optional: third-party archives (if you have keys)
# DOME_API_KEY=
# PREDEXON_API_KEY=
# LYCHEE_API_KEY=
